# OS / editor
.DS_Store
.idea/
.vscode/
*.swp

# Claude Code local settings
.claude/settings.local.json

# Local app generated files (rebuilt on site start)
app/.envrc
app/public/.htaccess
app/public/local-xdebuginfo.php
app/public/wp-config.php
conf/
logs/

# Secrets / database dumps / large data (regenerate, don't version)
app/sql/
backups/
*.sql
*.sql.gz

# WordPress core (upstream, reinstall for the version in the README)
app/public/wp-admin/
app/public/wp-includes/
app/public/*.php
app/public/*.html
app/public/*.txt

# Third-party and default themes (keep only the custom theme)
app/public/wp-content/themes/twenty*/

# Third-party plugins (keep only custom mu-plugins)
app/public/wp-content/plugins/*
!app/public/wp-content/plugins/index.php

# Media, caches and runtime files
app/public/wp-content/uploads/
app/public/wp-content/upgrade/
app/public/wp-content/cache/
app/public/wp-content/debug.log
